FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [pressure];

internalField
{
    type            zonal;

    defaultValue    101325;

    zones
    {
        postShock
        {
            type            box;

            box             (-1 -1 -1) (-0.0024 1 1);

            value           238600;
        }
    }
}

boundaryField
{
    minX
    {
        type            waveTransmissive;
        gamma           1.0;
        fieldInf        238600;
        lInf            5000;
        value           uniform 238600;
    }
    maxX
    {
        type            waveTransmissive;
        gamma           1.0;
        fieldInf        101325;
        lInf            5000;
        value           uniform 101325;
    }
    minY
    {
        type            symmetry;
    }
    maxY
    {
        type            symmetry;
    }
    minZ
    {
        type            symmetry;
    }
    maxZ
    {
        type            symmetry;
    }
}


