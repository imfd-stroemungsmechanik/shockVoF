/*--------------------------------*- C++ -*----------------------------------*\
  =========                 |
  \\      /  F ield         | OpenFOAM: The Open Source CFD Toolbox
   \\    /   O peration     | Website:  https://openfoam.org
    \\  /    A nd           | Version:  14
     \\/     M anipulation  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField   #codeStream
{
    codeInclude
    #{
      #include "volFields.H"
    #};

    codeOptions
    #{
        -I$(FOAM_SRC)/finiteVolume/lnInclude
    #};

    code
    #{
        // Get access to mesh
        const IOdictionary& d = static_cast<const IOdictionary&>(dict);
        const fvMesh& mesh = refCast<const fvMesh>(d.db());

        scalarField alpha(mesh.nCells(), 0.);

        // Radius of the droplet
        const scalar radius = 0.0024;

        // Period of the droplet array, 4D: the size of a single-droplet
        // domain.  The droplets sit at (0, j*L, k*L), see blockMeshDict
        const scalar L = 4*(2*radius);

        // Interface sharpness: the rho-THINC beta in system/fvSchemes (1.0 by
        // default), so the initial profile sits on the scheme's steady
        // interface
        const scalar beta = 1.0;

        forAll(alpha, celli)
        {
            // Cell center with y and z folded back onto the nearest droplet
            const vector& C = mesh.C()[celli];

            const scalar x = C.x();
            const scalar y = C.y() - L*std::round(C.y()/L);
            const scalar z = C.z() - L*std::round(C.z()/L);

            // Distance from the nearest droplet center
            const scalar d = sqrt(sqr(x) + sqr(y) + sqr(z));

            // Interface diffusion: scales with the cell size, so the
            // interface spans the same number of cells on every mesh
            const scalar eps = Foam::cbrt(mesh.V()[celli])/beta;

            alpha[celli] = 1.0 - 0.5 * (Foam::tanh((d - radius) / eps) + 1.0);
        }

        writeEntry(os, alpha);
    #};
};

boundaryField
{
    minX
    {
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }

    maxX
    {
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }

    minY
    {
        type            symmetry;
    }

    maxY
    {
        type            symmetry;
    }

    minZ
    {
        type            symmetry;
    }

    maxZ
    {
        type            symmetry;
    }
}

// ************************************************************************* //
