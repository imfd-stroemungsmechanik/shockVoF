FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

equationOfState
{
    type        stiffenedGas;
    gamma       4.4;
    pInf        6e8;
    Cv          602.1;
}

transport
{
    mu          1e-3;
    kappa       0.6;
}

// ************************************************************************* //
