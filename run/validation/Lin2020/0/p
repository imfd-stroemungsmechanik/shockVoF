FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [pressure];

internalField   uniform 39236;

boundaryField
{
    inlet_air
    {
        type            fixedValue;
        value           uniform 39236;
    }

    inlet_water
    {
        type            zeroGradient;
    }

    atmosphere
    {
        type            zeroGradient;
    }

    walls
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            symmetry;
    }
}

