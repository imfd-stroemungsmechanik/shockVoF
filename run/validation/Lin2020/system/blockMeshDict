FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

// Domain dimensions
xMin    -9.12;
xMax    9.12;
yMin    0;
yMax    18.24;
zMin    -9.12;
zMax    9.12;

// Mesh resolution
// 24 cells per jet diameter
// nx      36;
// ny      36;
// nz      36;

// 32 cells per jet diameter
// nx      48;
// ny      48;
// nz      48;

// 40 cells per jet diameter
nx      60;
ny      60;
nz      60;

// 48 cells per jet diameter
// nx      72;
// ny      72;
// nz      72;


vertices
(
    ($xMin $yMin $zMin)
    ($xMax $yMin $zMin)
    ($xMax $yMax $zMin)
    ($xMin $yMax $zMin)
    ($xMin $yMin $zMax)
    ($xMax $yMin $zMax)
    ($xMax $yMax $zMax)
    ($xMin $yMax $zMax)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx $ny $nz) simpleGrading (1 1 1)
);

boundary
(
    inlet_air
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }

    atmosphere
    {
        type patch;
        faces
        (
            (1 2 6 5)
            (3 7 6 2)
        );
    }

    frontAndBack
    {
        type symmetry;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }

    walls
    {
        type wall;
        faces
        (
            (0 1 5 4)
        );
    }
);


