FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          shockVoF;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         1e-3;

deltaT          1e-9;

writeControl    adjustableRunTime;

writeInterval   1e-4;

writeCompression on;

runTimeModifiable true;

adjustTimeStep  on;

maxCo           0.6;

maxAlphaCo      0.6;

// ************************************************************************* //
