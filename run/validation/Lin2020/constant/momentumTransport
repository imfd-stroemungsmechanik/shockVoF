FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      momentumTransport;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType  LES;

LES
{
    model           WALE;

    delta           cubeRootVol;

    turbulence      on;

    cubeRootVolCoeffs
    {
        deltaCoeff      1;
    }
}

