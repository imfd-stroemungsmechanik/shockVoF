FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

equationOfState
{
    type        idealGas;
    gamma       1.4;
    Cv          717.5;
}

transport
{
    mu          table
    (
        (110      0.76e-5)
        (166.7    1.13e-5)
        (210      1.39e-5)
        (250      1.60e-5)
        (300      1.85e-5)
        (320      1.94e-5)
    );

    kappa       0.026;
}

// ************************************************************************* //
