/*--------------------------------*- C++ -*----------------------------------*\
  =========                 |
  \\      /  F ield         | OpenFOAM: The Open Source CFD Toolbox
   \\    /   O peration     | Website:  https://openfoam.org
    \\  /    A nd           | Version:  14
     \\/     M anipulation  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField   #codeStream
{
    codeInclude
    #{
      #include "volFields.H"
    #};

    codeOptions
    #{
        -I$(FOAM_SRC)/finiteVolume/lnInclude
    #};

    code
    #{
        // Get access to mesh
        const IOdictionary& d = static_cast<const IOdictionary&>(dict);
        const fvMesh& mesh = refCast<const fvMesh>(d.db());

        scalarField alpha(mesh.nCells(), 0.);

        // Radius of the water column
        const scalar radius = 0.0024;

        // Interface sharpness: the rho-THINC beta in system/fvSchemes (1.0 by
        // default), so the initial profile sits on the scheme's steady
        // interface
        const scalar beta = 1.0;

        // In-plane cell size sqrt(dx*dy) of the pseudo-2D mesh
        const boundBox& bb = mesh.bounds();
        const scalar dz = bb.max().z() - bb.min().z();

        scalarField h(mesh.nCells());
        forAll(h, celli)
        {
            h[celli] = Foam::sqrt(mesh.V()[celli]/dz);
        }

        // Interface diffusion: the size of the finest cells, which resolve
        // the column, so the interface spans the same number of cells on
        // every mesh and the graded far field carries no trace of water
        const scalar eps = gMin(h)/beta;

        forAll(alpha, celli)
        {
            const scalar x = mesh.C()[celli].x();
            const scalar y = mesh.C()[celli].y();

            // Distance from center of coordinate system
            const scalar d = sqrt(sqr(x) + sqr(y));

            alpha[celli] = 1.0 - 0.5 * (Foam::tanh((d - radius) / eps) + 1.0);
        }

        writeEntry(os, alpha);
    #};
};

boundaryField
{
    inlet
    {
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }

    top
    {
        type            symmetry;
    }

    bottom
    {
        type            symmetry;
    }

    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
