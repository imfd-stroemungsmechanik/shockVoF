FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [velocity];

internalField
{
    type            zonal;

    defaultValue    (0 0 0);

    zones
    {
        postShock
        {
            type            box;

            box             (-1 -1 -1) (-0.0048 1 1);

            value           (225.9 0 0);
        }
    }
}

boundaryField
{
    inlet
    {
        type            waveTransmissive;
        gamma           1.0;
        fieldInf        (225.9 0 0);
        lInf            5000;
        value           uniform (225.9 0 0);
    }
    outlet
    {
        type            waveTransmissive;
        gamma           1.0;
        fieldInf        (0 0 0);
        lInf            5000;
        value           uniform (0 0 0);
    }
    bottom
    {
        type            symmetry;
    }
    top
    {
        type            symmetry;
    }
    frontAndBack
    {
        type            empty;
    }
}


