FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [temperature];

internalField   #codeStream
{
    codeInclude
    #{
      #include "volFields.H"
    #};

    codeOptions
    #{
        -I$(LIB_SRC)/finiteVolume/lnInclude
    #};

    code
    #{
        // Get access to mesh
        const IOdictionary& d = static_cast<const IOdictionary&>(dict);
        const fvMesh& mesh = refCast<const fvMesh>(d.db());

        // Vortex parameters
        const scalar gamma = 1.4;
        const scalar Rgas = 287.0;
        const scalar pInf = 1.0e5;
        const scalar Tinf = 300.0;
        const scalar vortex_strength = 100.0;
        const scalar vortex_core_radius = 0.01;
        const scalar vortex_center_x = 0.05;
        const scalar vortex_center_y = 0.05;

        scalarField T(mesh.nCells(), 0.0);

        forAll(T, i)
        {
            const scalar x  = mesh.C()[i].x() - vortex_center_x;
            const scalar y  = mesh.C()[i].y() - vortex_center_y;
            const scalar r2 = x*x + y*y;
            const scalar E  = exp(0.5*(1.0 - r2/(vortex_core_radius*vortex_core_radius)));

            const scalar dT = -(gamma - 1.0)/(2.0*gamma*Rgas)
                              *vortex_strength*vortex_strength * E*E;

            T[i] = Tinf + dT;
        }

        writeEntry(os, T);
    #};
};

boundaryField
{
    left
    {
        type    cyclic;
    }
    right
    {
        type    cyclic;
    }
    bottom
    {
        type    cyclic;
    }
    top
    {
        type    cyclic;
    }
    frontAndBack
    {
        type    empty;
    }
}


