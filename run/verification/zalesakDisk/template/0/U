FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [velocity];

internalField   #codeStream
{
    codeInclude
    #{
      #include "volFields.H"
    #};

    codeOptions
    #{
        -I$(LIB_SRC)/finiteVolume/lnInclude
    #};

    code
    #{
        const IOdictionary& d = static_cast<const IOdictionary&>(dict);
        const fvMesh& mesh = refCast<const fvMesh>(d.db());

        const scalar omega = 50.265482;
        const scalar xc = 0.5;
        const scalar yc = 0.5;

        vectorField U(mesh.nCells(), Zero);

        forAll(U, i)
        {
            const scalar x = mesh.C()[i].x() - xc;
            const scalar y = mesh.C()[i].y() - yc;

            U[i] = vector(-omega*y, omega*x, 0.0);
        }

        writeEntry(os, U);
    #};
};

boundaryField
{
    outer
    {
        type            codedFixedValue;
        value           uniform (0 0 0);
        name            outerBoundary;

        code
        #{
            const vectorField& Cf = patch().Cf();
            vectorField& field = *this;

            const scalar omega = 50.265482;
            const scalar xc = 0.5;
            const scalar yc = 0.5;

            forAll(Cf, faceI)
            {
                const scalar x = Cf[faceI].x() - xc;
                const scalar y = Cf[faceI].y() - yc;

                field[faceI] = vector(-omega*y, omega*x, 0.0);
            }
        #};
    }
    frontAndBack
    {
        type            empty;
    }
}


