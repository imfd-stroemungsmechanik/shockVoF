FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

L       1.0;

nCells  128;

vertices
(
    (0   0   -0.005)
    ($L  0   -0.005)
    ($L  $L  -0.005)
    (0   $L  -0.005)
    (0   0   0.005)
    ($L  0   0.005)
    ($L  $L  0.005)
    (0   $L  0.005)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nCells $nCells 1) simpleGrading (1 1 1)
);

boundary
(
    // All four lateral sides form a single patch with the exact
    // solid-body-rotation velocity (see 0/U); the disk never reaches it
    outer
    {
        type            patch;
        faces
        (
            (0 4 7 3)   // x-min
            (1 2 6 5)   // x-max
            (0 1 5 4)   // y-min
            (3 7 6 2)   // y-max
        );
    }
    frontAndBack
    {
        type            empty;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);


