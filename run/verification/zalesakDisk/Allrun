#!/bin/sh
cd ${0%/*} || exit 1    # Run from this directory

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

thinc_mode="none THINC"
resolution="32 64 128 256"

for mode in $thinc_mode; do

    for n in $resolution; do

        run_dir="run_${mode}_${n}"

        echo ""
        echo "============================================================"
        echo " Zalesak's disk at resolution N = ${n}, rhoTHINC ${mode}"
        echo "============================================================"

        cp -r template ${run_dir}

        touch ${run_dir}/para.foam

        foamDictionary ${run_dir}/system/blockMeshDict -entry nCells -value -set ${n}
        foamDictionary ${run_dir}/system/fvSchemes -entry interpolationSchemes/reconstruction/rhoTHINC/type -value -set ${mode}

        (
            cd ${run_dir}
            runApplication blockMesh
            runApplication decomposePar
            runParallel foamRun
            runApplication reconstructPar
        )

    done

done

python3 validateResults.py

