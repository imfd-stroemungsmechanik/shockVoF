FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          shockVoF;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.01;

deltaT          5e-7;

writeControl    adjustableRunTime;

writeInterval   0.01;

writePrecision  12;

adjustTimeStep  yes;

maxCo           0.3;

maxAlphaCo      0.3;

// ************************************************************************* //
