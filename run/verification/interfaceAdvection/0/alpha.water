FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField
{
    type            zonal;

    defaultValue    0;

    zones
    {
        waterColumn
        {
            type            box;

            box             (0.25 -1 -1) (0.75 1 1);

            value           1;
        }
    }
}

boundaryField
{
    inlet
    {
        type            cyclic;
    }

    outlet
    {
        type            cyclic;
    }

    empty
    {
        type            empty;
    }
}

// ************************************************************************* //
