FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      functions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

magU
{
    type            mag;
    libs            ("libfieldFunctionObjects.so");

    field           U;

    executeControl  writeTime;
    writeControl    writeTime;
}

sample
{
    type            sets;
    libs            ("libsampling.so");

    executeControl  writeTime;
    writeControl    writeTime;

    interpolationScheme cellPoint;

    setFormat       raw;

    fields
    (
        p
        rho
        mag(U)
        alpha.water
    );

    sets
    {
        data
        {
            type    lineCell;
            axis    x;
            start   (0 0 0);
            end     (1 0 0);
        }
    }
}

