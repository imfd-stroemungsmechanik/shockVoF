FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [temperature];

internalField
{
    type            zonal;

    defaultValue    6.9686;

    zones
    {
        waterColumn
        {
            type            box;

            box             (0 -1 -1) (0.5 1 1);

            value           781.58;
        }
    }
}

boundaryField
{
    sides
    {
        type            zeroGradient;
    }

    empty
    {
        type            empty;
    }
}

