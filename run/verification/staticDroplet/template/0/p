FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [pressure];

internalField   #codeStream
{
    codeInclude
    #{
      #include "volFields.H"
    #};

    codeOptions
    #{
        -I$(FOAM_SRC)/finiteVolume/lnInclude
    #};

    code
    #{
        // Get access to mesh
        const IOdictionary& d = static_cast<const IOdictionary&>(dict);
        const fvMesh& mesh = refCast<const fvMesh>(d.db());

        scalarField p(mesh.nCells());

        // Droplet radius [m]
        const scalar R = 5e-4;

        // Interface sharpness
        const scalar beta = 1.0;

        // Surface tension coefficient
        const scalar sigma = 8.0;

        // Ambient pressure
        const scalar pOut  = 101325;

        // Laplace pressure jump
        const scalar dP    = sigma/R;

        // z-thickness of the pseudo-2D mesh
        const boundBox& bb = mesh.bounds();
        const scalar dz = bb.max().z() - bb.min().z();

        forAll(p, celli)
        {
            const scalar x = mesh.C()[celli].x();
            const scalar y = mesh.C()[celli].y();
            const scalar r = Foam::sqrt(sqr(x) + sqr(y));

            const scalar h     = Foam::sqrt(mesh.V()[celli]/dz);
            const scalar xi    = (R - r)/h;
            const scalar alpha = 0.5*(1.0 + Foam::tanh(beta*xi));

            p[celli] = pOut + dP*alpha;
        }

        writeEntry(os, p);
    #};
};

boundaryField
{
    atmosphere
    {
        type            waveTransmissive;
        gamma           1.0;
        fieldInf        101325;
        lInf            0.01;
        value           uniform 101325;
    }

    frontAndBack
    {
        type            empty;
    }
}

