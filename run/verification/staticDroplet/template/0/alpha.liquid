FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alpha.liquid;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField   #codeStream
{
    codeInclude
    #{
      #include "volFields.H"
    #};

    codeOptions
    #{
        -I$(FOAM_SRC)/finiteVolume/lnInclude
    #};

    code
    #{
        // Get access to mesh
        const IOdictionary& d = static_cast<const IOdictionary&>(dict);
        const fvMesh& mesh = refCast<const fvMesh>(d.db());

        scalarField alpha(mesh.nCells());

        // Droplet radius [m]
        const scalar R = 5e-4;

        // Interface sharpness
        const scalar beta = 1.0;

        // z-thickness of the pseudo-2D mesh
        const boundBox& bb = mesh.bounds();
        const scalar dz = bb.max().z() - bb.min().z();

        forAll(alpha, celli)
        {
            const scalar x = mesh.C()[celli].x();
            const scalar y = mesh.C()[celli].y();
            const scalar r = Foam::sqrt(sqr(x) + sqr(y));

            // In-plane cell size = sqrt(dx*dy); signed distance (+ inside) / h
            const scalar h  = Foam::sqrt(mesh.V()[celli]/dz);
            const scalar xi = (R - r)/h;

            // THINC-consistent sigmoid: the interface spans the same number
            // of cells at any resolution
            alpha[celli] = 0.5*(1.0 + Foam::tanh(beta*xi));
        }

        writeEntry(os, alpha);
    #};
};

boundaryField
{
    atmosphere
    {
        type            fixedValue;
        value           uniform 0;
    }

    frontAndBack
    {
        type            empty;
    }
}

