FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

equationOfState
{
    type        idealGas;
    gamma       1.4;
    Cv          864;
}

transport
{
    mu          2e-5;
    kappa       0.026;
}

// ************************************************************************* //
