FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 0.001;

nCells  120;

vertices
(
    (-0.1666667 -0.1666667 -0.001)
    ( 0.1666667 -0.1666667 -0.001)
    ( 0.1666667  0.1666667 -0.001)
    (-0.1666667  0.1666667 -0.001)
    (-0.1666667 -0.1666667  0.001)
    ( 0.1666667 -0.1666667  0.001)
    ( 0.1666667  0.1666667  0.001)
    (-0.1666667  0.1666667  0.001)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nCells $nCells 1) simpleGrading (1 1 1)
);

boundary
(
    atmosphere
    {
        type wall;
        faces
        (
            (1 2 6 5)
            (3 7 6 2)
            (0 4 7 3)
            (0 1 5 4)
        );
    }

    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

