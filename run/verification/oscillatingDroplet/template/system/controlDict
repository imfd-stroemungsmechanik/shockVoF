FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          shockVoF;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         5e-4;

deltaT          2e-9;

writeControl    adjustableRunTime;

writeInterval   5e-4;

adjustTimeStep  yes;

maxCo           0.3;

maxAlphaCo      0.3;

writePrecision  12;

