FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties.liquid;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/constant/caseSetup"

equationOfState
{
    type        stiffenedGas;
    gamma       4.4;
    pInf        $pInfLiq;
    Cv          5.51633;
}

transport
{
    mu          0;
    kappa       0;
}

