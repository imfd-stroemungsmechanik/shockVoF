FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/constant/caseSetup"

dimensions      [pressure];

internalField   #codeStream
{
    codeInclude
    #{
      #include "volFields.H"
    #};

    codeOptions
    #{
        -I$(FOAM_SRC)/finiteVolume/lnInclude
    #};

    code
    #{
        // Get access to mesh
        const IOdictionary& d = static_cast<const IOdictionary&>(dict);
        const fvMesh& mesh = refCast<const fvMesh>(d.db());

        scalarField p(mesh.nCells());

        // Unperturbed droplet radius [m]
        const scalar R = 8.333333e-5;

        // Ellipse parameters
        const scalar a = 1.25*R;
        const scalar b = 0.8*R;

        // Surface tension coefficient
        const scalar sigma = 0.072;

        // Interface sharpness
        const scalar beta = 1.0;

        // Ambient pressure
        const scalar pOut = d.lookup<scalar>("pAmb");

        // Uniform interior pressure: the Laplace pressure of the
        // unperturbed circular droplet
        const scalar dP = sigma/R;

        const boundBox& bb = mesh.bounds();
        const scalar dz = bb.max().z() - bb.min().z();

        forAll(p, celli)
        {
            const scalar x = mesh.C()[celli].x();
            const scalar y = mesh.C()[celli].y();

            // Signed distance to the ellipse from the normalized level set
            const scalar phi = sqr(x/a) + sqr(y/b) - 1.0;
            const scalar gradPhi = Foam::sqrt(sqr(2.0*x/sqr(a)) + sqr(2.0*y/sqr(b)));
            const scalar dist = -phi/Foam::max(gradPhi, small);

            // In-plane cell size = sqrt(dx*dy)
            const scalar h = Foam::sqrt(mesh.V()[celli]/dz);

            const scalar alpha = 0.5*(1.0 + Foam::tanh(beta*dist/h));

            p[celli] = pOut + dP*alpha;
        }

        writeEntry(os, p);
    #};
};

boundaryField
{
    atmosphere
    {
        type            waveTransmissive;
        gamma           1.0;
        fieldInf        $pAmb;
        lInf            0.01;
        value           uniform $pAmb;
    }

    frontAndBack
    {
        type            empty;
    }
}

