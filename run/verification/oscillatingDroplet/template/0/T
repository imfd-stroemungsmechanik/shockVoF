FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/constant/caseSetup"

dimensions      [temperature];

internalField   uniform $Tamb;

boundaryField
{
    atmosphere
    {
        type            inletOutlet;
        inletValue      uniform $Tamb;
        value           uniform $Tamb;
    }

    frontAndBack
    {
        type            empty;
    }
}

